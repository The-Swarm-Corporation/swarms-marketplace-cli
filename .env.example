# Swarms Marketplace CLI — example environment file.
#
# IMPORTANT: the CLI reads configuration from environment variables only.
# It does NOT auto-load .env files. Copy this file and source it yourself:
#
#   cp .env.example .env
#   set -a && source .env && set +a
#
# or use direnv / your shell profile. `.env` is gitignored; never commit
# a file containing a real key.

# ── Required for authenticated commands ─────────────────────────────────────
# Bearer token for marketplace endpoints (launch, list, list-tokenized,
# claim-all enumeration). Get one: `swarms api-key` →
# https://swarms.world/platform/api-keys
SWARMS_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"

# ── Wallet key (on-chain operations) ────────────────────────────────────────
# Base58 wallet secret key for `claim`, `claim-all`, and `launch token`.
# Optional — the CLI prompts securely when unset. Held in memory only,
# never persisted. Preferred, scoped name:
#SWARMS_WALLET_PRIVATE_KEY="base58-secret-key"

# Fallback alias for the same wallet key, matching common .env conventions.
# Used only when SWARMS_WALLET_PRIVATE_KEY is unset.
#PRIVATE_KEY="base58-secret-key"

# ── Output tuning (optional) ────────────────────────────────────────────────
# Set to any value to disable the welcome animation, even in a TTY.
#SWARMS_NO_ANIM=1

# Standard flags the CLI honors for non-interactive environments.
#NO_COLOR=1
#CI=1
