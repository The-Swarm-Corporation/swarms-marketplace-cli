{
  "name": "swarms-market",
  "version": "0.1.2",
  "description": "Swarms Marketplace CLI — launch agents, prompts, and tokens, and claim fees from your tokenized products.",
  "keywords": [
    "swarms",
    "marketplace",
    "cli",
    "ai",
    "agents",
    "solana",
    "agent marketplace",
    "swarms marketplace",
    "ai agents",
    "autonomous agents",
    "multi-agent",
    "agent economy",
    "prompts",
    "prompt marketplace",
    "tokenized agents",
    "token launch",
    "creator fees",
    "llm",
    "web3",
    "swarms.world"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "swarms": "bin/swarms.js",
    "swarms-market": "bin/swarms.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:node && pnpm run test:vitest",
    "test:node": "node --import tsx --test tests/*.test.ts",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node bin/swarms.js",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.34.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.22.3",
    "typescript": "^5.5.0",
    "vitest": "^2.1.8"
  }
}
